# PostgreSQL connection string used by Prisma and by the seed script.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://erp_admin:erp_dev_password@127.0.0.1:5432/erp_manufacturing?schema=public"

# ---------------------------------------------------------------------
# The variables below are NOT used by this database-only stage.
# They are listed here because the backend stage (next step) will need
# them, and it's easier to reserve the names now than to discover a
# naming clash later.
# ---------------------------------------------------------------------

# JWT signing secret the backend will use for authentication.
# Generate one with: openssl rand -base64 48
# JWT_SECRET=""

# JWT access-token lifetime, e.g. "15m"
# JWT_EXPIRES_IN="15m"

# Port the backend API will listen on.
# PORT=4000
