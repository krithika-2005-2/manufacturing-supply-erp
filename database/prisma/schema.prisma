// =====================================================================
// ERP Database Schema — Manufacturing & Supply
// PostgreSQL + Prisma ORM
//
// Scope of this stage: DATABASE ONLY.
// No backend, no REST API, no JWT implementation, no UI here.
// This schema is designed so a backend can be built on top of it
// safely in the next stage.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ---------------------------------------------------------------------
// 1. USERS
// ---------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  enquiriesCreated   Enquiry[]    @relation("EnquiryCreatedBy")
  quotationsCreated  Quotation[]  @relation("QuotationCreatedBy")
  salesOrdersCreated SalesOrder[] @relation("SalesOrderCreatedBy")
  dispatchesCreated  Dispatch[]   @relation("DispatchCreatedBy")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------
// 2. CUSTOMERS
// ---------------------------------------------------------------------

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  companyName   String   @map("company_name")
  contactPerson String   @map("contact_person")
  mobile        String
  email         String?
  city          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@unique([mobile])
  @@index([companyName])
  @@index([city])
  @@map("customers")
}

// ---------------------------------------------------------------------
// 3. PRODUCTS
// ---------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  productCode String   @unique @map("product_code")
  productName String   @map("product_name")
  category    String
  unit        String
  basePrice   Decimal  @map("base_price") @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]

  @@index([category])
  @@map("products")
}

// ---------------------------------------------------------------------
// 4. INVENTORY
// ---------------------------------------------------------------------
// available_quantity is NOT stored — it is always derived as
// (physical_quantity - reserved_quantity). See README for the
// transactional reservation pattern and the fn_reserve_inventory /
// fn_dispatch_inventory / fn_release_inventory DB functions that
// enforce this safely under concurrency.

model Inventory {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @unique @map("product_id") @db.Uuid
  physicalQuantity  Int      @default(0) @map("physical_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

// ---------------------------------------------------------------------
// 5. CUSTOMER ENQUIRIES
// ---------------------------------------------------------------------

model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  enquiryNumber String        @unique @map("enquiry_number")
  customerId    String        @map("customer_id") @db.Uuid
  enquiryDate   DateTime      @default(now()) @map("enquiry_date") @db.Date
  requiredDate  DateTime?     @map("required_date") @db.Date
  status        EnquiryStatus @default(NEW)
  notes         String?
  createdById   String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User          @relation("EnquiryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     EnquiryItem[]
  quotations Quotation[]

  @@index([customerId])
  @@index([status])
  @@map("enquiries")
}

model EnquiryItem {
  id         String  @id @default(uuid()) @db.Uuid
  enquiryId  String  @map("enquiry_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([enquiryId])
  @@index([productId])
  @@map("enquiry_items")
}

// ---------------------------------------------------------------------
// 6. QUOTATIONS
// ---------------------------------------------------------------------

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @map("quotation_number")
  enquiryId       String          @map("enquiry_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  validUntil      DateTime        @map("valid_until") @db.Date
  status          QuotationStatus @default(DRAFT)
  grandTotal      Decimal         @default(0) @map("grand_total") @db.Decimal(14, 2)
  createdById     String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id], onDelete: Restrict)
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy  User            @relation("QuotationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@index([enquiryId])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationItem {
  id                 String  @id @default(uuid()) @db.Uuid
  quotationId        String  @map("quotation_id") @db.Uuid
  productId          String  @map("product_id") @db.Uuid
  quantity           Int
  unitPrice          Decimal @map("unit_price") @db.Decimal(12, 2)
  discountPercentage Decimal @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  gstPercentage      Decimal @default(0) @map("gst_percentage") @db.Decimal(5, 2)
  lineAmount         Decimal @map("line_amount") @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_items")
}

// ---------------------------------------------------------------------
// 7. SALES ORDERS
// ---------------------------------------------------------------------
// quotationId is UNIQUE: one quotation can generate at most one
// Sales Order (enforced at the DB level, not just app level).
// A BEFORE INSERT trigger (trg_check_quotation_accepted) additionally
// guarantees a Sales Order can only be created from an ACCEPTED
// quotation — see migration.sql.

model SalesOrder {
  id          String           @id @default(uuid()) @db.Uuid
  orderNumber String           @unique @map("order_number")
  quotationId String           @unique @map("quotation_id") @db.Uuid
  customerId  String           @map("customer_id") @db.Uuid
  orderDate   DateTime         @default(now()) @map("order_date") @db.Date
  totalAmount Decimal          @map("total_amount") @db.Decimal(14, 2)
  status      SalesOrderStatus @default(PENDING)
  createdById String           @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  quotation Quotation        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer  Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items     SalesOrderItem[]
  dispatches Dispatch[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  salesOrderId String  @map("sales_order_id") @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  lineAmount   Decimal @map("line_amount") @db.Decimal(14, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

// ---------------------------------------------------------------------
// 9. DISPATCH
// ---------------------------------------------------------------------

model Dispatch {
  id             String   @id @default(uuid()) @db.Uuid
  dispatchNumber String   @unique @map("dispatch_number")
  salesOrderId   String   @map("sales_order_id") @db.Uuid
  dispatchDate   DateTime @default(now()) @map("dispatch_date") @db.Date
  vehicleNumber  String   @map("vehicle_number")
  driverName     String   @map("driver_name")
  createdById    String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items      DispatchItem[]

  @@index([salesOrderId])
  @@map("dispatches")
}

model DispatchItem {
  id         String @id @default(uuid()) @db.Uuid
  dispatchId String @map("dispatch_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([dispatchId])
  @@index([productId])
  @@map("dispatch_items")
}
